# Postgres connection string used by the pipeline
DATABASE_URL=postgresql://user:password@localhost:5432/flock

# Anthropic API key (platform.claude.com -> API keys): extraction, the autonomy
# classifier and the resolver agent, with the default models below.
ANTHROPIC_API_KEY=
# Optional: Google Gemini API key. Only needed when EXTRACT_MODEL or
# RESOLVE_MODEL names a Gemini model (the fallback provider).
GEMINI_API_KEY=

# SAM.gov Entity API key (sam.gov -> Account Details -> API Key), used by the
# resolver's lookup_sam_entity tool. Without it that tool reports "unavailable".
SAM_API_KEY=
# Daily SAM.gov request cap for your key type; the pipeline counts requests
# itself. Personal key without a role: 10. With a role / system account: 1000.
SAM_DAILY_QUOTA=10

# Models, as <provider>:<model>. Providers: anthropic, gemini. A bare name with
# no prefix (gemini-3.8-flash) still means Gemini. Defaults live in
# pipeline/config.py. EXTRACT_MODEL also runs the classifier.
EXTRACT_MODEL=anthropic:claude-haiku-5-5
RESOLVE_MODEL=anthropic:claude-haiku-5-5

# Seconds between LLM calls (default shown). Raise it if you hit rate limits.
LLM_MIN_INTERVAL=1.0
# Estimated LLM spend per UTC month, in dollars, at which extraction, the
# classifier and the resolver stop for the month (default shown). Estimated
# from agent_runs at the prices in config/pricing.yaml.
MONTHLY_LLM_BUDGET_USD=90

# Per-run agent budgets (defaults shown; see pipeline/agents/budgets.py)
EXTRACT_REQUEST_LIMIT=2
RESOLVE_REQUEST_LIMIT=10
RESOLVE_TOOL_CALLS_LIMIT=8
RESOLVE_TOTAL_TOKENS_LIMIT=50000

# Optional: Logfire write token. Blank = no tracing. When set, every LLM call
# (DoD extraction, the classifier, the resolver agent) is traced. Also needs
# `uv sync --group observability`.
LOGFIRE_TOKEN=

# Optional: contact info appended to the User-Agent sent to government hosts,
# e.g. "you@example.org" or a project URL. Leave blank to omit.
FLOCK_CONTACT=

# OPTIONAL, off by default. war.gov blocks non-browser clients (Akamai 403) on
# contract announcement pages. Setting BOTH of these routes only those blocked
# page fetches through Bright Data Web Unlocker. Leave blank to disable; you
# can instead save pages from a browser into data/inbox/dod_contracts/.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
