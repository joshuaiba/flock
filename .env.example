# Postgres connection string used by the pipeline
DATABASE_URL=postgresql://user:password@localhost:5432/flock

# Google Gemini API key for llm.extract
GEMINI_API_KEY=

# Optional: contact info appended to the User-Agent sent to government hosts,
# e.g. "you@example.org" or a project URL. Leave blank to omit.
FLOCK_CONTACT=

# LLM provider for llm.extract (only "gemini" for now) and model override
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# OPTIONAL, off by default. war.gov blocks non-browser clients (Akamai 403) on
# contract announcement pages. Setting BOTH of these routes only those blocked
# page fetches through Bright Data Web Unlocker. Leave blank to disable; you
# can instead save pages from a browser into data/inbox/dod_contracts/.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
